{
  "name": "web-ui-boilerplate",
  "description": "UI boilerplate for websites & web apps using vanilla HTML/CSS/JavaScript, powered by Storybook, bundled by Parcel.",
  "author": "basher",
  "version": "6.8.2",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/basher/Web-UI-Boilerplate/"
  },
  "homepage": "https://basher.github.io/Web-UI-Boilerplate",
  "type": "module",
  "scripts": {
    "reset": "rm -rf node_modules/ && npm install",
    "ui-theme": "node ./scripts/ui-theme",
    "static-assets-move": "node ./scripts/static-assets-move",
    "bundle-all-themes": "node ./scripts/bundle-all-themes",
    "prestart": "rm -rf .parcel-cache",
    "start:theme": "cross-env NODE_ENV=development && cross-var npm run ui-theme $npm_config_theme && npm start",
    "start": "npm install && npm run start:parcel && npm run cem-analyze",
    "start:parcel": "parcel watch src/javascript/index.ts --dist-dir public --hmr-port 1234 --target app",
    "prebuild": "cross-var rm -rf public/build/ui/$npm_config_theme",
    "build:theme": "cross-env NODE_ENV=production && cross-var npm run ui-theme $npm_config_theme && npm run build",
    "build": "npm install && npm run build:parcel",
    "build:parcel": "parcel build src/javascript/index.ts --dist-dir public/build/ui",
    "postbuild": "cross-var npm run static-assets-move $npm_config_theme",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "publish-storybook": "npm install && npm run bundle-all-themes && npm run build-storybook",
    "test-storybook": "vitest --project=storybook --run --no-cache",
    "chromatic": "npm install && npm run bundle-all-themes && npx chromatic",
    "prepare": "cd .. && husky install ui/.husky",
    "cem-analyze": "cem analyze --config custom-elements-manifest.config.mjs"
  },
  "targets": {
    "app": {}
  },
  "browserslist": [
    "baseline 2024"
  ],
  "devDependencies": {
    "@babel/eslint-parser": "8.0.0-rc.2",
    "@chromatic-com/storybook": "^5.2.1",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/eslintrc": "^3.3.5",
    "@etchteam/storybook-addon-status": "^8.0.0",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-links": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/html-vite": "^10.3.5",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "@vueless/storybook-dark-mode": "^10.0.4",
    "chromatic": "^16.10.0",
    "colors": "^1.4.0",
    "cross-env": "^7.0.3",
    "cross-var-no-babel": "^1.2.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-storybook": "10.4.0",
    "fs-extra": "^10.1.0",
    "globals": "^17.6.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "parcel": "^2.14.4",
    "playwright": "^1.59.1",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "remark-gfm": "^4.0.0",
    "storybook": "^10.3.5",
    "storybook-design-token": "^5.0.0",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "svgo": "^3.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "invokers-polyfill": "^0.5.7",
    "scrollyfills": "^1.0.4"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.css": [
      "stylelint",
      "prettier --write"
    ]
  },
  "customElements": "public/custom-elements.json"
}
